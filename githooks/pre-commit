#!/bin/sh
# pre-commit hook: 检查暂存区的代码是否符合 clang-format 规范
#
# 安装: ./scripts/install-hooks.sh
# 或:   cp githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

if ! command -v git-clang-format >/dev/null 2>&1; then
    echo "WARNING: git-clang-format not found, skipping format check"
    echo "         Install with: pip install clang-format  (or use system package)"
    exit 0
fi

# 检查暂存区 C/C++ 文件
git clang-format --staged --diff --quiet
RET=$?

if [ $RET -ne 0 ]; then
    echo ""
    echo "============================================"
    echo "  clang-format 检查未通过！"
    echo "  请运行以下命令自动修复："
    echo ""
    echo "    git clang-format --staged"
    echo "    git add -u"
    echo ""
    echo "  然后重新提交。"
    echo "============================================"
    exit 1
fi

exit 0
